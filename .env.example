# Express web application
NODE_ENV=development
PORT=3000

# Optional remote sandbox providers for batch execution
JUDGE0_URL=https://ce.judge0.com
JUDGE0_KEY=
JUDGE0_RAPIDAPI_HOST=
PISTON_URL=
PISTON_KEY=

# True interactive terminal (stdin/stdout over WebSocket)
# Configure both values on the web service after deploying interactive-runner.
INTERACTIVE_GATEWAY_URL=wss://YOUR-GATEWAY-DOMAIN/session
INTERACTIVE_TICKET_SECRET=REPLACE_WITH_THE_SAME_RANDOM_SECRET_ON_BOTH_SERVICES

# Development only: enables the legacy in-process interactive runner.
# Do not enable this in production; it does not provide a security sandbox.
ALLOW_UNSANDBOXED_INTERACTIVE=false
