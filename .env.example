# Copy to .env and replace the secret before starting Docker Compose.
NODE_ENV=production
PORT=3000

# Generate with: openssl rand -hex 32
# The exact same value is used by the web service and interactive gateway.
INTERACTIVE_TICKET_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# For a browser on this same computer. For a remote deployment use a public
# wss:// hostname routed to the gateway through a TLS reverse proxy.
INTERACTIVE_GATEWAY_URL=ws://localhost:8080/session
MAX_INTERACTIVE_SESSIONS=4

# Optional batch execution providers.
JUDGE0_URL=https://ce.judge0.com
JUDGE0_KEY=
JUDGE0_RAPIDAPI_HOST=
PISTON_URL=
PISTON_KEY=

# Local development mode (no Docker required)
# When true, uses local-dev-gateway.js without container sandboxing.
# NEVER set to true in production.
LOCAL_DEV_MODE=false
LOCAL_DEV_PORT=8081
